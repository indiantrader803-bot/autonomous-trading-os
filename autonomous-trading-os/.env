# AUTONOMOUS TRADING OS (ATOS) ENVIRONMENT CONFIGURATION
APP_NAME=Autonomous Trading OS
APP_SHORT_NAME=ATOS
APP_TAGLINE=Intelligence. Discipline. Execution.
APP_ENV=development
APP_SECRET_KEY=atos_sec_9942a084c7d0498b965c4013470711bf88019a
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Trading Mode: OBSERVATION, PAPER, APPROVAL, AUTONOMOUS
TRADING_MODE=PAPER
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false
HALT_TRADING=false

# Database & Cache (Isolated Ports to prevent collision with other host services)
DATABASE_URL=postgresql://atos_user:atos_secure_pass@localhost:5434/atos_db
REDIS_URL=redis://localhost:6380/0

# Risk Defaults ($10 reference capital baseline)
REFERENCE_CAPITAL_USD=10.0
RISK_PER_TRADE_PERCENT=1.0
DAILY_LOSS_LIMIT_PERCENT=3.0
MAX_DRAWDOWN_PERCENT=10.0
MAX_SIMULTANEOUS_POSITIONS=1
INITIAL_LEVERAGE=1.0
MANDATORY_STOP_LOSS=true
MANDATORY_TAKE_PROFIT=true
MARTINGALE_ALLOWED=false
AVERAGING_DOWN_ALLOWED=false

# AI Providers (API keys configured via Settings UI or local protected storage)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Hyperliquid & Solana
HYPERLIQUID_TESTNET=true
HYPERLIQUID_WALLET_ADDRESS=
HYPERLIQUID_API_SECRET=
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
DEXSCREENER_ENABLED=true
BIRDEYE_API_KEY=
COINGECKO_API_KEY=

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
