# Copy to a protected server-side environment file; do not commit real secrets.
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM
APP_BASE_URL=https://your-domain.example
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false

DATABASE_URL=postgresql://trading_app:CHANGE_ME@postgres:5432/trading_os
REDIS_URL=redis://redis:6379/0

# AI providers (fill only in secure server environment)
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# Data providers — optional and verified by implementation
SOLANA_RPC_HTTP_URL=
SOLANA_RPC_WS_URL=
DEXSCREENER_ENABLED=true
BIRDEYE_API_KEY=
COINGECKO_API_KEY=

# Exchange credentials must be least-privilege and have no withdrawal permission.
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=
HYPERLIQUID_TESTNET=true

# Telegram is optional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Limits must be explicitly configured before any live activation
MAX_SLIPPAGE_PERCENT=
MAX_ORDER_NOTIONAL_USD=
